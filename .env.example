# --------------------------------------------------------------------
# Asta Gina Saka - CodeIgniter 4 Environment Configuration Template
# --------------------------------------------------------------------
# Salin file ini menjadi `.env` sebelum menjalankan aplikasi:
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# PERINGATAN: Jangan pernah commit file `.env` ke repository publik!
# --------------------------------------------------------------------

# --------------------------------------------------------------------
# ENVIRONMENT
# --------------------------------------------------------------------
# Nilai: development, production, testing
# Gunakan 'development' saat lokal untuk debugging.
# Gunakan 'production' saat live/deployment untuk keamanan.
CI_ENVIRONMENT = development

# --------------------------------------------------------------------
# APP CONFIGURATION
# --------------------------------------------------------------------
# URL dasar aplikasi (wajib berakhiran slash '/')
# Contoh lokal   : http://localhost:8080/ atau http://localhost/export-company/public/
# Contoh hosting : https://astaginasaka.page.gd/ atau https://yourdomain.com/
app.baseURL = 'http://localhost:8080/'

# Set ke true jika hosting sudah menggunakan HTTPS / SSL
# app.forceGlobalSecureRequests = false

# --------------------------------------------------------------------
# DATABASE CONFIGURATION
# --------------------------------------------------------------------
# Konfigurasi database MySQL / MariaDB
database.default.hostname = localhost
database.default.database = export_company
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

# --------------------------------------------------------------------
# ENCRYPTION
# --------------------------------------------------------------------
# Kunci enkripsi dapat di-generate dengan perintah: php spark key:generate
# encryption.key = 

# --------------------------------------------------------------------
# LOGGER
# --------------------------------------------------------------------
# Tingkat pencatatan log (0 = mati, 4 = semua log)
# logger.threshold = 4
